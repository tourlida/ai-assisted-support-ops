# Copy to .env and supply local values. Never commit .env.
NODE_ENV=development
PORT=3000
# Database connection is assembled from DATABASE_NAME, DATABASE_USER,
# DATABASE_PASSWORD, DATABASE_HOST, and DATABASE_PORT in the repository root .env.
# Replace with a long random value; never commit the local secret.
JWT_SECRET=***
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:5173
